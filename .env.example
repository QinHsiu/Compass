# Compass environment template — copy to `.env` (never commit real keys)
# All keys are OPTIONAL. Without a key, adaptive follow-ups use rule templates.
# Demo / docker compose work with COMPASS_DEMO=1 and fixtures only.

# --- LLM (OpenAI-compatible) ---
# COMPASS_LLM_PROVIDER=openai   # openai | deepseek | ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=              # override, e.g. https://api.deepseek.com/v1
# COMPASS_MODEL=                # e.g. gpt-4o-mini | deepseek-chat | llama3.2

# DeepSeek example:
# COMPASS_LLM_PROVIDER=deepseek
# OPENAI_API_KEY=sk-...
# COMPASS_MODEL=deepseek-chat

# Ollama example (no cloud key):
# COMPASS_LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# COMPASS_MODEL=llama3.2

# --- Runtime ---
# COMPASS_ROOT=content
# COMPASS_DEMO=1
# COMPASS_HOST=127.0.0.1
# COMPASS_LIVE_PORT=8766
# COMPASS_PORT=7860
# COMPASS_LIVE_URL=http://127.0.0.1:8766
